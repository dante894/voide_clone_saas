# Copiá este archivo a .env para correr en local (y cargá las variables con
# `export $(cat .env | xargs)` o con python-dotenv). En Render, estas mismas
# claves se configuran en el Dashboard o en render.yaml — NUNCA subas un
# archivo .env real a git.

SECRET_KEY=cambia-esto-por-algo-random-y-largo
DATABASE_URL=sqlite:///local.db
APP_BASE_URL=http://127.0.0.1:5000
DATA_DIR=

# Motor de generación de audio (Hugging Face Space con XTTS-v2)
HF_SPACE_URL=https://tuusuario-estudio-de-voz.hf.space
HF_SPACE_SECRET=una-clave-larga-y-random-que-vos-elijas

# Mercado Pago (credenciales de PRODUCCIÓN, panel de Mercado Pago -> Tus integraciones)
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
MP_PLAN_ID=
MP_PRO_PRICE_ARS=9999

# Login con Google (opcional; si se deja vacío, el botón de Google no aparece)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails que se promueven a admin automáticamente al iniciar sesión (separados por coma)
ADMIN_EMAILS=vos@tuemail.com
